/dts-v1/;

#include "meson-gxl-s905d.dtsi"
#include "meson-gx-p23x-q20x.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "videostrong,gxl-kii-pro", "amlogic,s905d", "amlogic,meson-gxl";
	model = "MeCool KII Pro";

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1710000>;

		button-function {
			label = "Update";
			linux,code = <KEY_VENDOR>;
			press-threshold-microvolt = <10000>;
		};
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		button {
			label = "power";
			linux,code = <KEY_POWER>;
			gpios = <&gpio_ao GPIOAO_2 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio GPIODV_24 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			panic-indicator;
		};
	};

	/* power of the DVB frontend, also needed for its reset line */
	nim_pwr: regulator-nim {
		compatible = "regulator-fixed";
		regulator-name = "NIM_PWR";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio GPIODV_11 GPIO_ACTIVE_LOW>;
		regulator-always-on;
	};
};

/* TS0 (tsin_a), parallel */
&demux {
	pinctrl-0 = <&tsin_a_parallel_pins>;
	pinctrl-names = "default";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			demux_ts0: endpoint {
				remote-endpoint = <&demod_ts>;
				bus-width = <8>;
			};
		};
	};
};

&ethmac {
	phy-mode = "rmii";
	phy-handle = <&internal_phy>;
};

&i2c_B {
	status = "okay";
	pinctrl-0 = <&i2c_b_pins>;
	pinctrl-names = "default";

	demodulator@14 {
		compatible = "availink,avl6862";
		reg = <0x14>;
		reset-gpios = <&gpio GPIODV_13 GPIO_ACTIVE_LOW>;
		/* orders the probe after the frontend power */
		vdd-supply = <&nim_pwr>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				demod_if: endpoint {
					remote-endpoint = <&tuner_if>;
				};
			};

			port@1 {
				reg = <1>;

				demod_ts: endpoint {
					remote-endpoint = <&demux_ts0>;
					bus-width = <8>;
				};
			};
		};
	};

	/* behind the I2C repeater of the demodulator */
	tuner@7a {
		compatible = "rafaelmicro,r912";
		reg = <0x7a>;
		vdd-supply = <&nim_pwr>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				tuner_if: endpoint {
					remote-endpoint = <&demod_if>;
				};
			};
		};
	};
};

&ir {
	linux,rc-map-name = "rc-mecool-kii-pro";
};

&sd_emmc_a {
	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a_pins>, <&uart_a_cts_rts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth {
		compatible = "brcm,bcm43438-bt";
		shutdown-gpios = <&gpio GPIOX_17 GPIO_ACTIVE_HIGH>;
		max-speed = <2000000>;
		clocks = <&wifi32k>;
		clock-names = "lpo";
	};
};
