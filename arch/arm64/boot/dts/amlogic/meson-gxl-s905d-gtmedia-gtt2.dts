/dts-v1/;

#include "meson-gxl-s905d.dtsi"
#include "meson-gx-p23x-q20x.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "gtmedia,gtt2", "amlogic,s905d", "amlogic,meson-gxl";
	model = "GTMedia GTT-2";

	/* CXD2878 crystal */
	xtal_cxd2878: clock-24000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	/* MxL603 crystal */
	xtal_mxl603: clock-16000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <16000000>;
	};

	i2c-display {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio GPIODV_23 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio GPIODV_22 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;

		display@24 {
			compatible = "fdhisi,fd650", "titanmec,tm1650";
			reg = <0x24>;

			digits {
				#address-cells = <1>;
				#size-cells = <0>;

				digit@0 {
					reg = <0>;
					segments = <3 0>, <3 6>, <3 4>, <3 2>,
						   <3 1>, <3 7>, <3 5>;
				};

				digit@1 {
					reg = <1>;
					segments = <2 0>, <2 6>, <2 4>, <2 2>,
						   <2 1>, <2 7>, <2 5>;
				};

				digit@2 {
					reg = <2>;
					segments = <1 0>, <1 6>, <1 4>, <1 2>,
						   <1 1>, <1 7>, <1 5>;
				};

				digit@3 {
					reg = <3>;
					segments = <0 0>, <0 6>, <0 4>, <0 2>,
						   <0 1>, <0 7>, <0 5>;
				};
			};

			leds {
				#address-cells = <2>;
				#size-cells = <0>;

				led@2,3 {
					reg = <2 3>;
					function = "colon";
				};
			};
		};
	};
};

/* TS0: tsin_a, parallel (vendor ts0 = "parallel", ts0_control = 0) */
&demux {
	pinctrl-0 = <&tsin_a_parallel_pins>;
	pinctrl-names = "default";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			demux_ts0: endpoint {
				remote-endpoint = <&cxd2878_ts>;
				bus-width = <8>;
			};
		};
	};
};

/* P231 has only internal PHY port */
&ethmac {
	phy-mode = "rmii";
	phy-handle = <&internal_phy>;
};

&i2c_B {
	status = "okay";
	pinctrl-0 = <&i2c_b_pins>;
	pinctrl-names = "default";

	demodulator@6c {
		compatible = "sony,cxd2878";
		reg = <0x6c>;
		clocks = <&xtal_cxd2878>;
		reset-gpios = <&gpio GPIODV_24 GPIO_ACTIVE_LOW>;

		i2c-gate {
			#address-cells = <1>;
			#size-cells = <0>;

			tuner@63 {
				compatible = "maxlinear,mxl603";
				reg = <0x63>;
				clocks = <&xtal_mxl603>;
				maxlinear,xtal-cap = <16>;
				maxlinear,invert-if;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@1 {
						reg = <1>;

						mxl603_if: endpoint {
							remote-endpoint = <&cxd2878_if>;
						};
					};
				};
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				cxd2878_if: endpoint {
					remote-endpoint = <&mxl603_if>;
				};
			};

			port@1 {
				reg = <1>;

				cxd2878_ts: endpoint {
					remote-endpoint = <&demux_ts0>;
					bus-width = <8>;
				};
			};
		};
	};
};

&sd_emmc_a {
	sdio: wifi@1 {
		reg = <1>;
	};
};
